{"code":"29-2055.00","slug":"surgical-technologists","title":"Surgical Technologists","description":"Assist in operations, under the supervision of surgeons, registered nurses, or other surgical personnel. May help set up operating room, prepare and transport patients for surgery, adjust lights and equipment, pass instruments and other supplies to surgeons and surgeons' assistants, hold retractors, cut sutures, and help count sponges, needles, supplies, and instruments.","jobZone":3,"wage":{"medianAnnual":64650,"employment":117460,"sharedWith":1,"soc":"29-2055","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"15242","text":"Maintain a proper sterile field during surgical procedures.","importance":5,"relevance":100,"frequency":6.53,"core":true,"dwaIds":["4.A.4.a.5.k.8"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"1959","text":"Count sponges, needles, and instruments before and after operation.","importance":4.98,"relevance":99.8,"frequency":6.46,"core":true,"dwaIds":["4.A.4.c.3.a.2"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"1960","text":"Hand instruments and supplies to surgeons and surgeons' assistants, hold retractors and cut sutures, and perform other tasks as directed by surgeon during operation.","importance":4.92,"relevance":100,"frequency":6.58,"core":true,"dwaIds":["4.A.4.a.5.k.6"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":