{"code":"29-9093.00","slug":"surgical-assistants","title":"Surgical Assistants","description":"Assist in operations, under the supervision of surgeons. May, in accordance with state laws, help surgeons to make incisions and close surgical sites, manipulate or remove tissues, implant surgical devices or drains, suction the surgical site, place catheters, clamp or cauterize vessels or tissue, and apply dressings to surgical site.","jobZone":3,"wage":{"medianAnnual":66800,"employment":22270,"sharedWith":1,"soc":"29-9093","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"19299","text":"Monitor and maintain aseptic technique throughout procedures.","importance":4.88,"relevance":100,"frequency":6.31,"core":true,"dwaIds":["4.A.4.a.5.k.8"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"19298","text":"Maintain an unobstructed operative field, using surgical retractors, sponges, or suctioning and irrigating equipment.","importance":4.82,"relevance":100,"frequency":5.78,"core":true,"dwaIds":["4.A.3.a.3.d.3"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"19312","text":"Pass instruments or supplies to surgeon during procedure.","importance":4.76,"relevance":100,"frequency":6.12,"core":true,"dwaIds":["4.A.4.a.5.k.6"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","eviden