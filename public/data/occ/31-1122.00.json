{"code":"31-1122.00","slug":"personal-care-aides","title":"Personal Care Aides","description":"Provide personalized assistance to individuals with disabilities or illness who require help with personal care and activities of daily living support (e.g., feeding, bathing, dressing, grooming, toileting, and ambulation). May also provide help with tasks such as preparing meals, doing light housekeeping, and doing laundry. Work is performed in various settings depending on the needs of the care recipient and may include locations such as their home, place of work, out in the community, or at a daytime nonresidential facility.","jobZone":2,"wage":{"medianAnnual":35800,"employment":4305810,"sharedWith":2,"soc":"31-1120","note":"aggregate","source":"BLS OEWS May 2025"},"tasks":[{"id":"2370","text":"Administer bedside or personal care, such as ambulation or personal hygiene assistance.","importance":4.65,"relevance":94.6,"frequency":5.46,"core":true,"dwaIds":["4.A.4.a.5.c.2"],"short":"Personal hygiene assistance","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"aeiClaudeShare":null,"aeiApiShare":null,"aeiClaudeAutomation":null,"aeiApiAutomation":null,"aeiClaudeWorkShare":null,"aeiApiWorkShare":null,"peopleWork":true,"seenRarely":false,"automationBasis":null,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"2371","text":"Prepare and maintain records of client progress and services performed, reporting changes in client condition to manager or supervisor.","importance":4.65,"relevance":92.1,"frequency":5.28,"core":true,"dwaIds":["4.A.3.b.6.f.2","4.A.3.b.6.h.6"],"short":"Client progress charting","evidence":{"theoryLabel":"E2","gpt4Label":"E1","theorySource":"human+gpt4","theory":0.75,"observed":true,"everObserved":true,"aeiShare":0.0001,"aeiSource":"claude_ai","aei