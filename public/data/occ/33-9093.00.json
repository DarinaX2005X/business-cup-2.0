{"code":"33-9093.00","slug":"transportation-security-screeners","title":"Transportation Security Screeners","description":"Conduct screening of passengers, baggage, or cargo to ensure compliance with Transportation Security Administration (TSA) regulations. May operate basic security equipment such as x-ray machines and hand wands at screening checkpoints.","jobZone":2,"wage":{"medianAnnual":66770,"employment":50290,"sharedWith":1,"soc":"33-9093","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"15341","text":"Inspect carry-on items, using x-ray viewing equipment, to determine whether items contain objects that warrant further investigation.","importance":4.91,"relevance":85.2,"frequency":6.3,"core":true,"dwaIds":["4.A.1.b.2.j.5"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15348","text":"Search carry-on or checked baggage by hand when it is suspected to contain prohibited items such as weapons.","importance":4.8,"relevance":92.6,"frequency":5.6,"core":true,"dwaIds":["4.A.1.b.2.j.5"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15351","text":"View images of checked bags and cargo, using remote screening equipment, and alert baggage screeners or handlers to any possible problems.","importance":4.72,"relevance":66.7,"frequency":6.67,"core":false,"dwaIds":["4.A.1.b.2.j.5","4.A.4.a.2.g.1"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15332","text":"Check passengers' tickets to ensure that they are valid, and to determine whether passengers have designations that require special handling, such as providing photo identification.","importance":4.71,"relevance":88.9,"frequency":6.08,"core":true,"dwaIds":["4.A.2.a.2.e.1"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15350","text":"Test baggage for any explosive materials, using equipment such as explosive detection machines or chemical swab systems.","importance":4.69,"relevance":100,"frequency":6.37,"core":true,"dwaIds":["4.A.1.b.2.j.5"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15346","text":"Perform pat-down or hand-held wand searches of passengers who have triggered machine alarms, who are unable to pass through metal detectors, or who have been randomly identified for such searches.","importance":4.65,"relevance":85.2,"frequency":6.35,"core":true,"dwaIds":["4.A.3.a.1.k.11"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15345","text":"Notify supervisors or other appropriate personnel when security breaches occur.","importance":4.63,"relevance":100,"frequency":2.37,"core":true,"dwaId