,"relevance":88.9,"frequency":5.79,"core":true,"dwaIds":["4.A.3.b.6.b.8"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15352","text":"Watch for potentially dangerous persons whose pictures are posted at checkpoints.","importance":4,"relevance":81.5,"frequency":3.23,"core":true,"dwaIds":["4.A.1.a.2.g.7"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15335","text":"Contact leads or supervisors to discuss objects of concern that are not on prohibited object lists.","importance":3.96,"relevance":100,"frequency":4.85,"core":true,"dwaIds":["4.A.4.a.2.g.1"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15334","text":"Confiscate dangerous items and hazardous materials found in opened bags and turn them over to airlines for disposal.","importance":3.92,"relevance":88.9,"frequency":5.17,"core":true,"dwaIds":["4.A.3.a.1.k.9"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15344","text":"Monitor passenger flow through screening checkpoints to ensure order and efficiency.","impor