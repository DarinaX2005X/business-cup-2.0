hend them.","importance":4.57,"relevance":85.2,"frequency":1.7,"core":true,"dwaIds":["4.A.1.a.2.f.6"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15339","text":"Inform other screeners when baggage should not be opened because it might contain explosives.","importance":4.52,"relevance":85.2,"frequency":2.96,"core":true,"dwaIds":["4.A.4.a.2.g.1"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15342","text":"Inspect checked baggage for signs of tampering.","importance":4.42,"relevance":88.9,"frequency":6.17,"core":true,"dwaIds":["4.A.1.b.2.j.5"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"15331","text":"Ask passengers to remove shoes and divest themselves of metal objects prior to walking through metal detectors.","importance":4.41,"relevance":88.5,"frequency":6.48,"core":true,"dwaIds":["4.A.4.a.2.c.21"],"evidence":{"theoryLabel":"E2","theorySource":"human","theory":0.5,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0.25,"category":"ai_speeds","evidenceLevel":"estimate"}},{"id":"15333","text":"Close entry areas following security breaches or reopen areas after receiving notification that the airport 