{"code":"49-3022.00","slug":"automotive-glass-installers-and-repairers","title":"Automotive Glass Installers and Repairers","description":"Replace or repair broken windshields and window glass in motor vehicles.","jobZone":2,"wage":{"medianAnnual":47630,"employment":20310,"sharedWith":1,"soc":"49-3022","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"8325","text":"Select appropriate tools, safety equipment, and parts, according to job requirements.","importance":4.51,"relevance":100,"frequency":6.1,"core":true,"dwaIds":["4.A.2.b.1.h.11"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":true,"aeiShare":0,"aeiSource":"claude_ai","aeiAutomation":0.6957,"aeiWorkShare":0,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"20645","text":"Prime all scratches on pinchwelds with primer and allow to dry.","importance":4.4,"relevance":93.2,"frequency":5.94,"core":true,"dwaIds":["4.A.3.a.2.ag.2","4.A.3.b.4.d.2"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"8318","text":"Remove all dirt, foreign matter, and loose glass from damaged areas, apply primer along windshield or window edges, and allow primer to dry.","importance":4.39,"relevance":100,"frequency":5.66,"core":true,"dwaIds":["4.A.3.a.2.ag.2","4.A.3.b.4.d.2"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"8323","text":"Check for and remove moisture or contamination in damaged areas and keep areas dry until repairs are complete.","importance":4.3,"relevance":96.7,"frequency":5.61,"core":true,"dwaIds":["4.A.3.a.1.h.5"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"8324","text":"Apply a bead of urethane around the perimeter of each pinchweld and dress the remaining urethane on the pinchwelds so that it is of uniform level and thickness.","importance":4.28,"relevance":94.9,"frequency":5.8,"core":true,"dwaIds":["4.A.3.b.4.d.2"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"8322","text":"Obtain windshields or windows for specific automobile makes and models from stock and examine them for defects prior to installation.","importance":4.25,"relevance":94.9,"frequency":5.65,"core":true,"dwaIds":["4.A.1.b.2.d.6"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"8329","text":"Install, repair, or replace safety glass and related materials, such as back glass heating elements, on vehicles or equipment.","importance":4.21,"relevance":93.2,"frequency":5.89,"core":true,"dwaIds":["4.A.3.b.4.d.2","4.A.3.b.4.d.4"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"cate