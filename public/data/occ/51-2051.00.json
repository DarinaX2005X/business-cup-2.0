:null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13975","text":"Bond wood reinforcing strips to decks and cabin structures of watercraft, using resin-saturated fiberglass.","importance":4.02,"relevance":85.6,"frequency":4.74,"core":true,"dwaIds":["4.A.3.a.1.g.6"],"short":"Bond wood reinforcing strips","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13978","text":"Repair or modify damaged or defective glass-fiber parts, checking thicknesses, densities, and contours to ensure a close fit after repair.","importance":4.02,"relevance":61.4,"frequency":4.54,"core":false,"dwaIds":["4.A.3.b.4.b.4"],"short":"Repair defective glass-fiber parts","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13981","text":"Mask off mold areas not to be laminated, using cellophane, wax paper, masking tape, or special sprays containing mold-release substances.","importance":4.02,"relevance":65.6,"frequency":4.07,"core":false,"dwaIds":["4.A.3.a.1.g.6"],"short":"Mask mold areas not","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13983","text":"Check all dies, templates, and cutout patterns to be used in the manufacturing process to ensur