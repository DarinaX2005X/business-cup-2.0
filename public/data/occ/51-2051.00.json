{"code":"51-2051.00","slug":"fiberglass-laminators-and-fabricators","title":"Fiberglass Laminators and Fabricators","description":"Laminate layers of fiberglass on molds to form boat decks and hulls, bodies for golf carts, automobiles, or other products.","jobZone":2,"wage":{"medianAnnual":46880,"employment":16170,"sharedWith":1,"soc":"51-2051","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"13970","text":"Release air bubbles and smooth seams, using rollers.","importance":4.55,"relevance":99.8,"frequency":5.47,"core":true,"dwaIds":["4.A.3.a.2.o.3"],"short":"Release air bubbles","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13971","text":"Spray chopped fiberglass, resins, and catalysts onto prepared molds or dies using pneumatic spray guns with chopper attachments.","importance":4.47,"relevance":76,"frequency":5.38,"core":true,"dwaIds":["4.A.3.a.1.f.4"],"short":"Spray chopped fiberglass","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"13980","text":"Apply layers of plastic resin to mold surfaces prior to placement of fiberglass mats, repeating layers until products have the desired thicknesses and plastics have jelled.","importance":4.44,"relevance":56.6,"frequency":5.53,"core":false,"dwaIds":["4.A.3.a.2.an.1"],"short":"Apply layers","evidence":{"theoryLabel":"E0","gpt4Label":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetrat