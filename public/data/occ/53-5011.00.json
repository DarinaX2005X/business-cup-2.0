{"code":"53-5011.00","slug":"sailors-and-marine-oilers","title":"Sailors and Marine Oilers","description":"Stand watch to look for obstructions in path of vessel, measure water depth, turn wheel on bridge, or use emergency equipment as directed by captain, mate, or pilot. Break out, rig, overhaul, and store cargo-handling gear, stationary rigging, and running gear. Perform a variety of maintenance tasks to preserve the painted surface of the ship and to maintain line and ship equipment. Must hold government-issued certification and tankerman certification when working aboard liquid-carrying vessels. Includes able seamen and ordinary seamen.","jobZone":2,"wage":{"medianAnnual":51520,"employment":31670,"sharedWith":1,"soc":"53-5011","note":null,"source":"BLS OEWS May 2025"},"tasks":[{"id":"14457","text":"Maintain government-issued certifications, as required.","importance":4.51,"relevance":97.9,"frequency":2.38,"core":true,"dwaIds":["4.A.2.b.3.a.16"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14461","text":"Handle lines to moor vessels to wharfs, to tie up vessels to other vessels, or to rig towing lines.","importance":4.42,"relevance":99.2,"frequency":5.22,"core":true,"dwaIds":["4.A.3.a.2.w.1"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14458","text":"Lower and man lifeboats when emergencies occur.","importance":4.31,"relevance":51.8,"frequency":2.1,"core":false,"dwaIds":["4.A.4.a.5.e.4"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14462","text":"Stand watch in ships' bows or bridge wings to look for obstructions in a ship's path or to locate navigational aids, such as buoys or lighthouses.","importance":4.29,"relevance":78.9,"frequency":4.02,"core":true,"dwaIds":["4.A.1.a.2.g.11"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14460","text":"Steer ships under the direction of commanders or navigating officers or direct helmsmen to steer, following designated courses.","importance":4.23,"relevance":37.8,"frequency":3.92,"core":false,"dwaIds":["4.A.3.a.4.a.1"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14482","text":"Tie barges together into tow units for tugboats to handle, inspecting barges periodically during voyages and disconnecting them when destinations are reached.","importance":4.13,"relevance":59.7,"frequency":4.2,"core":false,"dwaIds":["4.A.1.b.2.g.7","4.A.3.a.2.w.1"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14464","text":"Overhaul lifeboats or lifeboat gear and lower or raise lifeboats with winches or falls.","importance":4.07,"relevance":36.2,"frequency":1.93,"core":false,"dwaIds":["4.A.3.a.1.f.1"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14476","text":"Examine machinery to verify specified pressures or lubricant flows.","importance":4.02,"relevance":66.2,"frequency":4.36,"core":false,"dwaIds":["4.A.1.b.2.g.18"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14475","text":"Read pressure and temperature gauges or displays and record data in engineering logs.","importance":3.89,"relevance":64.4,"frequency":4.81,"core":false,"dwaIds":["4.A.1.a.2.a.13","4.A.3.b.6.h.3"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":false,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14479","text":"Attach hoses and operate pumps to transfer substances to and from liquid cargo tanks.","importance":3.89,"relevance":65.3,"frequency":3.28,"core":false,"dwaIds":["4.A.3.a.2.ah.1","4.A.3.a.3.b.3"],"evidence":{"theoryLabel":"E0","theorySource":"human","theory":0,"observed":false,"everObserved":false,"aeiShare":null,"aeiSource":null,"aeiAutomation":null,"aeiWorkShare":null,"penetration":0,"history":null,"physical":true,"exposure":0,"category":"human_edge","evidenceLevel":"estimate"}},{"id":"14469","text":"Splice and repair ropes, wire cables, or cordage, using marlinespikes, wire cutters, twine, and hand tools.","importan