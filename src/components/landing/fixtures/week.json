  "texts": {
    "ru": {
      "1839": {
        "text": "Вести точные и подробные отчеты и медицинские записи.",
        "short": "Ведение сестринской документации"
      },
      "1840": {
        "text": "Отслеживать, фиксировать и передавать врачам информацию о симптомах или изменениях в состоянии пациентов.",
        "short": "Фиксация изменений состояния"
      },
      "1841": {
        "text": "Регистрировать медицинскую информацию пациентов и показатели их жизненно важных функций.",
        "short": "Внесение показателей и данных"
      },
      "1842": {
        "text": "Корректировать планы лечения пациентов в зависимости от их состояния и реакции на терапию.",
        "short": "Коррекция плана сестринского ухода"
      },
      "1843": {
        "text": "Консультироваться и координировать действия с членами медицинской бригады для оценки, планирования и реализации плана ухода за пациентом.",
        "short": "Согласование плана ухода"
      },
      "1846": {
        "text": "Руководить младшим медперсоналом или координировать работу конкретного отделения.",
        "short": "Руководство младшим персоналом"
      },
      "1847": {
        "text": "Подготавливать пациентов к осмотрам или лечебным процедурам и ассистировать при их проведении.",
        "short": "Подготовка к процедурам"
      },
      "1850": {
        "text": "Инструктировать пациентов и их семьи по вопросам гигиены, профилактики заболеваний или родов, а также разрабатывать программы оздоровления.",
        "short": "Обучение пациентов и профилактика"
      },
      "1851": {
        "text": "Подготавливать кабинеты, стерильные инструменты, оборудование или расходные материалы и следить за поддержанием их запасов.",
        "short": "Подготовка стерильных материалов"
      },
      "1862": {
        "text": "Проводить или организовывать обучение и инструктаж вспомогательного персонала или студентов.",
        "short": "Обучение персонала и студентов"
      },
      "20413": {
        "text": "Вводить пациентам лекарственные препараты и отслеживать возможные реакции или побочные эффекты.",
        "short": "Введение лекарств и наблюдение"
      }
    },
    "kk": {
      "1839": {
        "text": "Нақты әрі егжей-тегжейлі есептер мен медициналық жазбаларды жүргізу.",
        "short": "Медициналық есеп жүргізу"
      },
      "1840": {
        "text": "Пациенттердің жағдайындағы симптомдарды немесе өзгерістерді бақылау, жазып алу және хабарлау.",
        "short": "Симптомдар динамикасын тіркеу"
      },
      "1841": {
        "text": "Пациенттердің медициналық ақпаратын және өмірлік маңызды көрсеткіштерін жазып алу.",
        "short": "Өмірлік көрсеткіштерді тіркеу"
      },
      "1842": {
        "text": "Пациенттердің жағдайы мен емге реакциясына байланысты емдеу жоспарларына өзгерістер енгізу.",
        "short": "Емдеу жоспарын түзету"
      },
      "1843": {
        "text": "Пациентті күту жоспарларын бағалау, құру, жүзеге асыру үшін медициналық топ мүшелерімен кеңесу және үйлестіру.",
        "short": "Күтім жоспарын үйлестіру"
      },
      "1846": {
        "text": "Біліктілігі төмен мейіргерлік немесе медициналық қызметкерлерге бағыт-бағдар беру, қадағалау немесе бөлімшені басқару.",
        "short": "Қызметкерлерді қадағалау"
      },
      "1847": {
        "text": "Науқастарды қарап-тексеруге немесе емдеуге дайындау және осы процедураларға көмектесу.",
        "short": "Науқастарды қарап-тексеруге дайындау"
      },
      "1850": {
        "text": "Жеке адамдарға, отбасыларға немесе топтарға денсаулықты сақтау, аурулардың алдын алу немесе босану бойынша нұсқау беру және бағдарламалар әзірлеу.",
        "short": "Пациенттерді оқыту"
      },
      "1851": {
        "text": "Бөлмелерді, зарарсыздандырылған құралдарды, жабдықтар мен материалдарды дайындау және құрал-саймандар қорының жеткілікті болуын қамтамасыз ету.",
        "short": "Бөлме мен құралдарды дайындау"
      },
      "1862": {
        "text": "Қосымша персоналды немесе студенттерді оқытуды қамтамасыз ету немесе ұйымдастыру.",
        "short": "Қызметкерлер мен студенттерді оқыту"
      },
      "20413": {
        "text": "Пациенттерге дәрі-дәрмектерді енгізу және реакциялар немесе жанама әсерлердің пайда болуын бақылау.",
        "short": "Дәрі-дәрмек енгізу"
      }
    }
  },
